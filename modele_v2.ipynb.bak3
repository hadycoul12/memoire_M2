      "   6. region_destination             (|SHAP| moyen = 0.1379)\n",
      "   7. groupe_fournisseur             (|SHAP| moyen = 0.1016)\n",
      "   8. type_hebergement               (|SHAP| moyen = 0.0929)\n",
