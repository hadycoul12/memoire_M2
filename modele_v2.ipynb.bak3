   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Imports & configuration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "f94bdb79",
   "metadata": {},
   "outputs": [
